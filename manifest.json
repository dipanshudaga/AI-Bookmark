{
  "manifest_version": 3,
  "name": "AI Bookmarks",
  "version": "1.0.0",
  "description": "Bookmarks you can actually find. Ask in plain words and AI searches all of them.",
  "permissions": [
    "bookmarks",
    "favicon",
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "AI Bookmarks",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "114",
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open AI Bookmarks"
    }
  }
}
