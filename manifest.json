{
  "manifest_version": 3,
  "name": "AI Bookmark Search",
  "version": "1.0.0",
  "description": "AI-powered bookmark categorizer & natural language search. Ask questions like 'what are some design agencies' and get relevant bookmarks.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
